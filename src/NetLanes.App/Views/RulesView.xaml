<UserControl x:Class="NetLanes.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NetLanes.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:RulesViewModel}"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Application Speed Rules" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="Configure speed caps and lane assignments for specific executables." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="📁 Browse Executable..." Style="{StaticResource PrimaryButtonStyle}" Command="{Binding BrowseExecutableCommand}" VerticalAlignment="Center"/>
        </Grid>

        <!-- EDIT FORM (Visible when IsEditing == true) -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Background="#16202F" BorderBrush="{StaticResource PrimaryCyanBrush}" Margin="0,0,0,16"
                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Configure Application Rule" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14"/>

                <!-- Path & Name -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Executable Path" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <TextBlock Text="Display Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding EditDisplayName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Assigned Lane" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" ItemsSource="{Binding AvailableLanes}" DisplayMemberPath="Name" SelectedItem="{Binding EditSelectedLane}"/>
                    </StackPanel>
                </Grid>

                <!-- Custom Limits Toggle & Fields -->
                <CheckBox Content="Override Lane with Custom Application Limits" Foreground="{StaticResource TextPrimaryBrush}" IsChecked="{Binding EditUseCustomLimits}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,16" Visibility="{Binding EditUseCustomLimits, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Custom Download Limit" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox Style="{StaticResource ModernTextBox}" Width="100" Text="{Binding EditCustomDownValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EditIsCustomDownUnlimited, Converter={StaticResource BoolToVisInv}}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Width="90" Margin="8,0,0,0" ItemsSource="{Binding SupportedUnits}" SelectedItem="{Binding EditCustomDownUnit}" IsEnabled="{Binding EditIsCustomDownUnlimited, Converter={StaticResource BoolToVisInv}}"/>
                        </StackPanel>
                        <CheckBox Content="Unlimited" Foreground="{StaticResource TextSecondaryBrush}" IsChecked="{Binding EditIsCustomDownUnlimited}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Custom Upload Limit" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBox Style="{StaticResource ModernTextBox}" Width="100" Text="{Binding EditCustomUpValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding EditIsCustomUpUnlimited, Converter={StaticResource BoolToVisInv}}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Width="90" Margin="8,0,0,0" ItemsSource="{Binding SupportedUnits}" SelectedItem="{Binding EditCustomUpUnit}" IsEnabled="{Binding EditIsCustomUpUnlimited, Converter={StaticResource BoolToVisInv}}"/>
                        </StackPanel>
                        <CheckBox Content="Unlimited" Foreground="{StaticResource TextSecondaryBrush}" IsChecked="{Binding EditIsCustomUpUnlimited}"/>
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelEditCommand}" Margin="0,0,8,0"/>
                    <Button Content="Save Rule" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveEditCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RULES GRID -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0">
            <DataGrid ItemsSource="{Binding Rules}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#222D3E"
                      Background="Transparent"
                      RowBackground="Transparent"
                      BorderThickness="0"
                      SelectionMode="Single"
                      RowHeight="46"
                      FontSize="13">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#121824"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Enabled Toggle -->
                    <DataGridTemplateColumn Header="ENABLED" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                          Command="{Binding DataContext.ToggleRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                          CommandParameter="{Binding}"
                                          VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Application / Path -->
                    <DataGridTemplateColumn Header="APPLICATION" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Assigned Lane -->
                    <DataGridTextColumn Header="LANE" Binding="{Binding LaneName}" Width="150"/>

                    <!-- Effective Limits -->
                    <DataGridTextColumn Header="EFFECTIVE LIMITS" Binding="{Binding EffectiveLimitsDisplay}" Width="200"/>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="Edit" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"
                                            Command="{Binding DataContext.StartEditRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Margin="0,0,6,0"/>
                                    <Button Content="Delete" Style="{StaticResource SecondaryButtonStyle}" Padding="8,4"
                                            Command="{Binding DataContext.DeleteRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
